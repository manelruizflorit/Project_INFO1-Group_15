<+>class Airport:\n    def __init__(self, code: str, latitude:float , longitude: float):\n        if len(code) != 4:\n            raise ValueError(\"Invalid ICAO code\")\n        self.code = code.upper()\n        self.latitude = latitude\n        self.longitude = longitude\n        self.schengen = False\ndef IsSchengenAirport(code):\n    if  not code:\n        return False\n    codigos = ['LO', 'EB', 'LK', 'LC', 'EK', 'EE', 'EF', 'LF', 'ED', 'LG', 'EH', 'LH', 'BI', 'LI', 'EV', 'EY', 'EL', 'LM', 'EN', 'EP', 'LP', 'LZ', 'LJ', 'LE', 'ES', 'LS']\n    encontrado = False\n    i = 0\n    while i < len(codigos) and not encontrado:\n        if codigos[i] == code[0:2]:\n            encontrado = True\n        else:\n            i += 1\n    if encontrado:\n        return True\ndef SetSchengen(airport: Airport):\n    airport.schengen = IsSchengenAirport(airport.code)\ndef PrintAirport(airport: Airport):\n    print(\"Airport code: \", airport.code)\n    print(\"Latitude: \", airport.latitude)\n    print(\"Longitude: \", airport.longitude)\n    print(\"Schengen: \", airport.schengen)\n\ndef LoadAirports(Airportsfile):\n    F = open(\"Airportsfile\", \"r\")\n    next(F)\n    Aerodatos = F.readline()\n    while Aerodatos != \"\":\n        elementos = Aerodatos.split(\" \")\n        ICAO = elementos[0]\n        Latitude = elementos[1]\n        Longitude = elementos[2]\n        Lat_signe = 1\n        Long_signe = 1\n        if Latitude[0] == \"S\":\n            Lat_signe = -1\n        if Longitude[0] == \"W\":\n            Long_signe = -1\n        latitud = (float(Latitude[1:3]) + float(Latitude[3:5])/60 + float(Latitude[5:7])/3600)*Lat_signe\n        longitud = (float(Longitude[1:3]) + float(Longitude[3:5])/60 + float(Longitude[5:7])/3600)*Long_signe\n        print(ICAO + \" \" + str(latitud) + \" \" + str(longitud))\n        Aerodatos = F.readline()\n    F.close()\n\n\ndef SaveSchengenAirports(Airportsfile, schengenAirports):\n    F = open(Airportsfile, \"r\")\n    Aeropuerto = F.readline()\n    Q = open(\"schengenAirports.txt\", \"w\")\n    while Aeropuerto != \"\":\n        elementos = Aeropuerto.split(\" \")\n        if IsSchengenAirport(elementos[0]) == True:\n            Q.write(Aeropuerto)\n            next(Q)\n    Q.close()\n    F.close()\nSaveSchengenAirports(Airportsfile.txt,schengenAirports)\n\n\n\n
