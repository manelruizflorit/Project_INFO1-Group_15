<+>def LoadAirports(Airportsfile):\n    F = open(\"Airports\", \"r\")\n    airport = F.readline()\n    while airport != \"\":\n        elementos = airport.split(\" \")\n        Aeropuerto = str(elementos[0])\n        Lat = str(elementos[1])\n        Lon = str(elementos[2])\n        sur = False\n        latitud = 0\n        oeste = False\n        if Lat[0] == \"S\":\n            sur = True\n        else:\n            sur = False\n        if Lon[0] == \"W\":\n            oeste = True\n        else:\n            oeste = False\n        if sur == false:\n            latitud = Lat[1,2]+(lat[3,4])/60 + (lat[5,6])/3600\n\n\n    F.close()\n\nprint(float(Latitud))\n\n\n\n\n
