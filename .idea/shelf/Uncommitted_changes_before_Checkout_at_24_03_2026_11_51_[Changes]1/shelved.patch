diff --git a/Addairportcode.py b/Addairportcode.py
new file mode 100644
--- /dev/null	(date 1774348880423)
+++ b/Addairportcode.py	(date 1774348880423)
@@ -0,0 +1,25 @@
+def AddAirport(Airportsfile,Airport):
+    code = str(input("ICAO code of the Airport: ")).upper()
+    Newlat = float(input("Latitude of the Airport: "))
+    Newlong = float(input("Longitude of the Airport: "))
+    F = open(Airportsfile,"a")
+    next(F)
+    Writtenairports = F.readline()
+    elements = Writtenairports.split()
+    if elements[0] == code:
+        F.write(code + " " + Newlat + " " + Newlong + "\n")
+        print("Airport already saved")
+    else:
+        while elements[0] != code and Writtenairports != "":
+            if elements[0] == code:
+                F.write(code + " " + Newlat + " " + Newlong + "\n")
+                print("Saved")
+            else:
+                F.readline()
+                Writtenairports = F.readline()
+                elements = Writtenairports.split()
+    F.close()
+
+
+
